# Release package for the Arch User Repository. Replace @ARCHIVE_SHA256@
# with the checksum of the published v0.6.3 source archive before submission.
pkgname=xray-ctl
pkgver=0.6.3
pkgrel=1
pkgdesc='Xray TUN manager with multiple VLESS subscriptions and split tunneling'
arch=('any')
url='https://github.com/nyaphys/xray-ctl'
license=('MIT')
depends=('python' 'curl' 'xray' 'sudo' 'iproute2')
provides=('blancctl')
conflicts=('blancctl')
replaces=('blancctl')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('@ARCHIVE_SHA256@')

package() {
    local source_root="${srcdir}/${pkgname}-${pkgver}"
    install -Dm755 "${source_root}/app/blancctl.py" "${pkgdir}/usr/bin/xray-ctl"
    ln -s xray-ctl "${pkgdir}/usr/bin/blancctl"
    install -Dm755 "${source_root}/lib/blancctl-setup" "${pkgdir}/usr/bin/xray-ctl-setup"
    ln -s xray-ctl-setup "${pkgdir}/usr/bin/blancctl-setup"
    install -Dm755 "${source_root}/lib/service-control" "${pkgdir}/usr/lib/blancctl/service-control"
    install -Dm755 "${source_root}/lib/tun-route" "${pkgdir}/usr/lib/blancctl/tun-route"
    install -Dm644 "${source_root}/systemd/blancctl.service" "${pkgdir}/usr/lib/systemd/system/blancctl.service"
    install -Dm644 "${source_root}/systemd/blancctl-failover.service" "${pkgdir}/usr/lib/systemd/system/blancctl-failover.service"
    install -Dm644 "${source_root}/systemd/blancctl-failover.timer" "${pkgdir}/usr/lib/systemd/system/blancctl-failover.timer"
    install -Dm440 "${source_root}/sudoers/blancctl" "${pkgdir}/etc/sudoers.d/blancctl"
    install -Dm644 "${source_root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
